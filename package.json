{
  "name": "fansightful-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "verify": "npm run check && npm run build && npm run test && node scripts/check-dist.mjs",
    "astro": "astro",
    "test:coverage": "vitest run --coverage --coverage.include='src/tools/**/*.ts' --coverage.exclude='**/*.test.ts'",
    "check:launch": "node scripts/check-dist.mjs --launch",
    "test:e2e": "playwright test",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
