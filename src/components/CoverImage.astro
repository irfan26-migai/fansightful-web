---
// Foto sampul berkredit. Foto stok selalu diberi keterangan "Foto ilustrasi" agar tidak terbaca sebagai kasus nyata.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  credit: string;
  creditUrl: string;
  /** true untuk gambar di atas lipatan (LCP). */
  priority?: boolean;
}

const { src, alt, credit, creditUrl, priority = false } = Astro.props;
---

<figure class="cover">
  <Image
    src={src}
    alt={alt}
    widths={[480, 768, 1080, 1440]}
    sizes="(min-width: 48rem) 44rem, 100vw"
    format="webp"
    quality={72}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  <figcaption>Foto ilustrasi: <a href={creditUrl} rel="noopener">{credit}</a></figcaption>
</figure>

<style>
  .cover {
    margin: var(--space-6) 0;
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  figcaption a {
    color: inherit;
  }
</style>
