---
import { id as t } from '../i18n/id';
import { loadInsights } from '../lib/load-insights';
import { isInsightsListed } from '../lib/insights';

const showInsights = isInsightsListed((await loadInsights()).length);
const links = [
  { href: '/tools-lab/', label: t.nav.toolsLab },
  ...(showInsights ? [{ href: '/insights/', label: t.nav.insights }] : []),
  { href: '/solusi/', label: t.nav.solusi },
  { href: '/tentang/', label: t.nav.tentang },
  { href: '/kontak/', label: t.nav.kontak },
  { href: '/privasi/', label: t.nav.privasi },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <nav aria-label={t.a11y.footerNav}>
      <ul class="footer-nav">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <p class="footer-note">{t.footer.note}</p>
    <p class="footer-note">© {year} {t.site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-muted);
    font-size: var(--text-sm);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .footer-nav a {
    color: var(--color-ink);
  }

  .footer-note {
    max-width: var(--measure);
    color: var(--color-ink-muted);
    margin-bottom: var(--space-2);
  }
</style>
