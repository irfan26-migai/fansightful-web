---
import { id as t } from '../i18n/id';

interface Props {
  title?: string;
  description?: string;
  /** Path kanonis, mis. "/tools-lab/". Default: path halaman saat ini. */
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Objek JSON-LD tambahan untuk halaman ini. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = t.site.description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} — ${t.site.name}` : `${t.site.name} — Pahami masalah bisnis, temukan langkah berikutnya`;
const canonical = new URL(canonicalPath, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={t.site.name} />
<meta property="og:locale" content="id_ID" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
