---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverImage from '../../components/CoverImage.astro';
import { loadInsights, type Insight } from '../../lib/load-insights';
import { insightHref } from '../../lib/insights';
import { formatDate, isoDate } from '../../lib/format';
import { AREAS } from '../../tools/health-check/instrument';
import { id as t } from '../../i18n/id';

export async function getStaticPaths() {
  const insights = await loadInsights();
  return insights.map((insight) => ({ params: { slug: insight.slug }, props: { insight } }));
}

interface Props {
  insight: Insight;
}

const { insight } = Astro.props;
const { data } = insight.entry;
const { Content } = await render(insight.entry);
const areaTitles = data.areas.map((id) => AREAS.find((a) => a.id === id)!.title);
const url = new URL(insightHref(insight.slug), Astro.site).href;

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  author: { '@type': 'Person', name: data.author },
  datePublished: isoDate(data.publishedAt),
  dateModified: isoDate(data.updatedAt ?? data.publishedAt),
  inLanguage: 'id-ID',
  mainEntityOfPage: url,
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.site.name, item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t.insights.title, item: new URL('/insights/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: data.title, item: url },
  ],
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogType="article"
  noindex={data.draft}
  jsonLd={data.draft ? [] : [article, breadcrumbs]}
>
  <article class="container article">
    {data.draft && <p class="draft-notice" data-pending="Artikel masih draf">{t.insights.draftNotice}</p>}

    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/insights/">{t.insights.title}</a>
    </nav>
    <p class="eyebrow">{areaTitles.join(' · ')}</p>
    <h1>{data.title}</h1>
    <p class="meta">
      {t.insights.by} {data.author} · {t.insights.published}{' '}
      <time datetime={isoDate(data.publishedAt)}>{formatDate(data.publishedAt)}</time>
      {
        data.updatedAt && (
          <>
            {' '}
            · {t.insights.updated} <time datetime={isoDate(data.updatedAt)}>{formatDate(data.updatedAt)}</time>
          </>
        )
      }
    </p>

    {data.cover && <CoverImage {...data.cover} priority />}

    <aside class="summary" aria-labelledby="ringkasan">
      <h2 id="ringkasan">{t.insights.summaryTitle}</h2>
      <ul>
        {data.summary.map((s) => <li>{s}</li>)}
      </ul>
    </aside>

    <div class="body prose">
      <Content />
    </div>

    <aside class="tool" aria-labelledby="tool-cta">
      <h2 id="tool-cta">{t.insights.toolTitle}</h2>
      <p>{t.insights.toolBody}</p>
      <a class="button" href="/tools-lab/health-check/">{t.healthCheck.start}</a>
    </aside>

    {
      data.sources.length > 0 && (
        <section class="sources" aria-labelledby="sumber">
          <h2 id="sumber">{t.insights.sourcesTitle}</h2>
          <ol>
            {data.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener">
                  {s.title}
                </a>
                {s.accessedAt && (
                  <span>
                    {' '}
                    ({t.insights.accessed} {formatDate(s.accessedAt)})
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--space-8);
  }

  .article > * {
    max-width: var(--measure);
  }

  .crumbs {
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .crumbs a::before {
    content: '← ';
  }

  .meta {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .summary,
  .tool {
    margin-block: var(--space-8);
    padding: var(--space-6);
    border-radius: var(--radius);
  }

  .summary {
    border-left: 4px solid var(--color-accent);
    background: var(--color-accent-soft);
  }

  .summary h2,
  .tool h2,
  .sources h2 {
    font-size: var(--text-lg);
  }

  .summary ul {
    margin: 0;
    padding-left: var(--space-6);
  }

  .tool {
    border: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .body :global(h2) {
    margin-top: var(--space-8);
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: var(--space-6);
  }

  .body :global(li) {
    margin-bottom: var(--space-2);
  }

  .draft-notice {
    padding: var(--space-3) var(--space-4);
    border: 2px dashed #8a5a00;
    border-radius: var(--radius);
    background: var(--color-warning-soft);
    color: #5c3c00;
    font-weight: 600;
  }

  .sources ol {
    padding-left: var(--space-6);
    font-size: var(--text-sm);
  }
</style>
