---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadInsights } from '../../lib/load-insights';
import { insightHref, isInsightsListed } from '../../lib/insights';
import { formatDate, isoDate } from '../../lib/format';
import { AREAS } from '../../tools/health-check/instrument';
import { id as t } from '../../i18n/id';

const insights = await loadInsights();
// Sebelum ada cukup artikel, halaman ini tetap ada (agar tautan tidak rusak) tetapi tidak diindeks.
const listed = isInsightsListed(insights.length);
const areaTitle = (id: string) => AREAS.find((a) => a.id === id)!.title;
---

<BaseLayout title={t.insights.title} description={t.insights.description} noindex={!listed}>
  <section class="container insights">
    <p class="eyebrow">Insights</p>
    <h1>{t.insights.title}</h1>
    <p class="lead prose">{t.insights.intro}</p>

    {
      insights.length === 0 ? (
        <div class="prose">
          <p>{t.insights.empty}</p>
          <a class="button" href="/tools-lab/health-check/">
            {t.healthCheck.start}
          </a>
        </div>
      ) : (
        <ul class="list">
          {insights.map((i) => (
            <li class="item">
              <p class="meta">
                {i.areas.map(areaTitle).join(' · ')}
                {i.draft && <strong> · DRAF</strong>}
              </p>
              <h2>
                <a href={insightHref(i.slug)}>{i.title}</a>
              </h2>
              <p>{i.entry.data.description}</p>
              <p class="meta">
                <time datetime={isoDate(i.publishedAt)}>{formatDate(i.publishedAt)}</time> · {i.entry.data.author}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .insights {
    padding-block: var(--space-12) var(--space-8);
  }

  .list {
    max-width: var(--measure);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .item {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .item h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .item h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .item h2 a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .meta {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>
