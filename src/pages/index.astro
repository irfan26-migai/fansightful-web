---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import heroPhoto from '../assets/images/hero-tim-papan-tugas.jpg';
import Pending from '../components/Pending.astro';
import { FOUNDER } from '../config';
import { id as t } from '../i18n/id';
import { loadInsights } from '../lib/load-insights';
import { insightHref, isInsightsListed } from '../lib/insights';
import type { IconName } from '../lib/icons';

// Struktur mengikuti artboard "Beranda" paket desain v2, disesuaikan dengan yang benar-benar tersedia:
// hanya Health Check yang bisa dipakai; tool lain berlabel "Direncanakan" dan tidak ditautkan.
// Section "Insight terbaru" hanya tampil bila sudah ada minimal 3 artikel.
const insights = await loadInsights();
const latest = isInsightsListed(insights.length) ? insights.slice(0, 3) : [];
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t.site.name,
  url: Astro.site?.href,
  description: t.site.description,
};

const TOOL = '/tools-lab/health-check/';

type Domain = 'people' | 'ops' | 'fin' | 'tech';

const valueProps: { icon: IconName; tone: string; title: string; body: string }[] = [
  { icon: 'calc', tone: '', title: 'Tools interaktif', body: 'untuk keputusan yang lebih cepat' },
  { icon: 'book', tone: 'tile--ops', title: 'Insight praktis', body: 'dari pengalaman nyata' },
  { icon: 'briefcase', tone: 'tile--people', title: 'Solusi relevan', body: 'saat Anda siap melangkah' },
];

// Area Health Check yang benar-benar diperiksa disebut di kartu agar tautannya jujur.
const domains: { key: Domain; icon: IconName; name: string; title: string; body: string; href?: string }[] = [
  {
    key: 'people',
    icon: 'users',
    name: 'People & HR',
    title: 'Kelola tim & kinerja',
    body: 'Peran, struktur tim, dan praktik kinerja — diperiksa di Health Check.',
    href: TOOL,
  },
  {
    key: 'ops',
    icon: 'cog',
    name: 'Bisnis & Operasional',
    title: 'Rapikan operasional',
    body: 'Tujuan, prioritas, dan proses kerja — diperiksa di Health Check.',
    href: TOOL,
  },
  {
    key: 'fin',
    icon: 'coins',
    name: 'Finance & Efisiensi',
    title: 'Rencanakan biaya SDM',
    body: 'Hitung biaya tenaga kerja dan bandingkan skenario dalam Rupiah.',
  },
  {
    key: 'tech',
    icon: 'grid',
    name: 'Sales & Teknologi',
    title: 'Pilih tools & aplikasi',
    body: 'HRIS, CRM, dan finance tools yang sesuai kebutuhan.',
  },
];

const steps: { icon: IconName; title: string; body: string }[] = [
  { icon: 'search', title: 'Temukan', body: 'Mulai dari masalah nyata, bukan daftar topik.' },
  { icon: 'book', title: 'Pahami', body: 'Penyebab yang mungkin, konteks, dan buktinya.' },
  { icon: 'calc', title: 'Uji', body: 'Periksa kondisi dengan tool, dengan aturan yang terbuka.' },
  { icon: 'send', title: 'Bertindak', body: 'Interpretasi jelas dan satu sampai tiga langkah praktis.' },
  { icon: 'trend', title: 'Kembali & tumbuh', body: 'Ulangi pemeriksaan setelah perbaikan untuk melihat perubahan.' },
];

const tools: { domain: Domain; icon: IconName; title: string; body: string; status: string; href?: string }[] = [
  {
    domain: 'people',
    icon: 'pulse',
    title: t.healthCheck.title,
    body: 'Diagnostik awal: peran, struktur tim, tujuan, proses, dan praktik kinerja.',
    status: 'Mulai di sini',
    href: TOOL,
  },
  {
    domain: 'people',
    icon: 'target',
    title: 'KPI & Performance Designer',
    body: 'Susun hubungan tujuan, ukuran, target, dan pemiliknya. Hasilnya bisa diedit.',
    status: 'Direncanakan',
  },
  {
    domain: 'fin',
    icon: 'calc',
    title: 'HR Cost & Workforce Calculator',
    body: 'Estimasi biaya tenaga kerja dalam Rupiah dengan asumsi yang terbuka.',
    status: 'Direncanakan',
  },
];

const segments: { icon: IconName; label: string }[] = [
  { icon: 'rocket', label: 'Startup' },
  { icon: 'store', label: 'UMKM' },
  { icon: 'factory', label: 'Manufaktur' },
  { icon: 'briefcase', label: 'Jasa profesional' },
  { icon: 'building', label: 'Perusahaan keluarga' },
  { icon: 'grid', label: 'Agensi & kreatif' },
];

// Pratinjau hero: tampilan hasil dengan jawaban contoh, bukan data pengguna.
const preview = [
  { area: 'Peran & tanggung jawab', status: 'Perlu perhatian', tone: 'attention' },
  { area: 'Tujuan & prioritas', status: 'Mulai terbentuk', tone: 'forming' },
  { area: 'Struktur tim', status: 'Relatif terbentuk', tone: 'ok' },
];

const initials = FOUNDER?.name
  .split(' ')
  .slice(0, 2)
  .map((w) => w[0])
  .join('');
---

<BaseLayout jsonLd={[organization]}>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <span class="pill">Knowledge &amp; Tools Ecosystem</span>
      <h1 id="hero-title">Ubah pertanyaan bisnis menjadi langkah nyata.</h1>
      <p class="hero__lead">
        Tools interaktif, insight praktis, dan solusi relevan untuk membantu founder, business builder, dan manajer
        membangun bisnis yang lebih sehat dan bertumbuh.
      </p>
      <div class="actions">
        <a class="button button--lg" href={TOOL}>Coba Business Health Check <Icon name="arrow" /></a>
        <a class="button button--secondary button--lg" href="/tools-lab/">Jelajahi Tools</a>
      </div>
      <ul class="value-props">
        {
          valueProps.map((v) => (
            <li>
              <span class:list={['tile tile--sm', v.tone]}>
                <Icon name={v.icon} />
              </span>
              <span>
                <strong>{v.title}</strong>
                <span>{v.body}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero__visual">
      <div class="hero__blob" aria-hidden="true"></div>
      <!-- Foto stok sementara (src/assets/images/CREDITS.md); arahan v3 meminta foto asli. -->
      <Image
        class="hero__photo"
        src={heroPhoto}
        alt="Empat rekan kerja berdiskusi di depan papan tugas kantor; salah satunya menunjuk papan"
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 64rem) 36rem, 100vw"
        format="webp"
        quality={70}
        loading="eager"
        fetchpriority="high"
      />
      <div class="preview">
        <div class="preview__head">
          <span class="tile tile--sm"><Icon name="pulse" /></span>
          <div>
            <p class="preview__title">Business Health Check</p>
            <p class="preview__sub">Sekitar 10 menit · 5 area</p>
          </div>
        </div>
        <ul class="preview__rows">
          {
            preview.map((p) => (
              <li>
                <span>{p.area}</span>
                <span class:list={['status', `status--${p.tone}`]}>{p.status}</span>
              </li>
            ))
          }
        </ul>
        <div class="preview__next">
          <span class="tile tile--sm tile--next"><Icon name="send" /></span>
          <p>Langkah berikutnya: daftar lima keputusan rutin yang paling sering menunggu Anda.</p>
        </div>
      </div>
      <figcaption>Contoh tampilan hasil dengan jawaban contoh</figcaption>
    </figure>
  </section>

  <section class="band" aria-labelledby="domains-title">
    <div class="container section">
      <h2 id="domains-title">Mulai dari tantangan yang paling relevan untuk Anda</h2>
      <p class="section__lead">Pilih area. Kami arahkan ke tool dan insight yang tersedia.</p>
      <ul class="domain-grid">
        {
          domains.map((d) => (
            <li class:list={['domain-card', { 'domain-card--link': d.href }]}>
              <span class:list={['tile', `tile--${d.key}`]}>
                <Icon name={d.icon} />
              </span>
              <span class:list={['domain-card__name', `domain-card__name--${d.key}`]}>{d.name}</span>
              <h3>{d.href ? <a href={d.href}>{d.title}</a> : d.title}</h3>
              <p>{d.body}</p>
              {!d.href && <span class="pill pill--muted">Direncanakan</span>}
            </li>
          ))
        }
        <li class="domain-card domain-card--navy">
          <span class="tile tile--on-navy">
            <Icon name="pulse" />
          </span>
          <span class="domain-card__name">Belum yakin mulai dari mana?</span>
          <h3>
            <a href={TOOL}>Cek kondisi bisnis Anda dulu</a>
          </h3>
          <span class="domain-card__cta">
            Mulai Health Check <Icon name="arrow" />
          </span>
        </li>
      </ul>
    </div>
  </section>

  <section id="cara-kerja" class="container section" aria-labelledby="how-title" tabindex="-1">
    <h2 id="how-title">Dari mengenali masalah ke tahu langkah berikutnya</h2>
    <p class="section__lead">
      Setiap artikel dan tool di Fansightful dirancang untuk membawa Anda satu langkah lebih maju.
    </p>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class:list={['step', { 'step--next': i === 3 }]}>
            <div class="step__top">
              <span class:list={['tile tile--sm', { 'tile--next': i === 3 }]}>
                <Icon name={s.icon} />
              </span>
              <span class="step__num" aria-hidden="true">
                {i + 1}
              </span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section" aria-labelledby="tools-title">
    <div class="section__head">
      <div>
        <h2 id="tools-title">Tools Lab</h2>
        <p class="section__lead">Gratis dipakai. Asumsi dan cara hitungnya selalu terbuka.</p>
      </div>
      <a class="arrow-link" href="/tools-lab/">Lihat Tools Lab <Icon name="arrow" /></a>
    </div>
    <ul class="tool-grid">
      {
        tools.map((tool) => (
          <li class="tool-card">
            <div class="tool-card__top">
              <span class:list={['tile', `tile--${tool.domain}`]}>
                <Icon name={tool.icon} />
              </span>
              <span class:list={['pill', tool.href ? 'pill--next' : 'pill--muted']}>{tool.status}</span>
            </div>
            <h3>{tool.title}</h3>
            <p>{tool.body}</p>
            {tool.href ? (
              <>
                <p class="tool-card__meta">
                  <Icon name="clock" /> Sekitar 10 menit · <span class="pill pill--sample">{t.healthCheck.sampleBadge}</span>
                </p>
                <div>
                  <a class="button" href={tool.href}>
                    Coba sekarang <Icon name="arrow" />
                  </a>
                </div>
              </>
            ) : (
              <p class="tool-card__meta">Belum tersedia</p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container" aria-labelledby="segments-title">
    <div class="segments">
      <h2 id="segments-title">Dibuat untuk bisnis seperti</h2>
      <ul>
        {
          segments.map((s) => (
            <li>
              <Icon name={s.icon} />
              {s.label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="container section" aria-labelledby="latest-title">
        <div class="section__head">
          <div>
            <h2 id="latest-title">{t.insights.latest}</h2>
            <p class="section__lead">Analisis praktis dari masalah bisnis di Indonesia. Setiap tulisan berujung pada satu langkah.</p>
          </div>
          <a class="arrow-link" href="/insights/">
            {t.insights.all} <Icon name="arrow" />
          </a>
        </div>
        <ul class="article-grid">
          {latest.map((i) => (
            <li class="article-card">
              {i.entry.data.cover && (
                <Image
                  class="article-card__img"
                  src={i.entry.data.cover.src}
                  alt=""
                  widths={[400, 720]}
                  sizes="(min-width: 64rem) 22rem, 100vw"
                  format="webp"
                  quality={70}
                />
              )}
              <span class="pill pill--people">People &amp; HR</span>
              <h3>
                <a href={insightHref(i.slug)}>{i.title}</a>
              </h3>
              <p>{i.entry.data.description}</p>
              <span class="article-card__next">
                <Icon name="send" /> Langkah berikutnya: Health Check
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="container section" aria-labelledby="help-title">
    <div class="help">
      <div>
        <h2 id="help-title">Butuh bantuan menerapkan?</h2>
        <p>
          Tools dan insight tetap gratis. Saat Anda butuh keahlian lebih dalam, kami jelaskan terbuka siapa penyedianya.
        </p>
      </div>
      <div class="actions">
        <a class="button" href="/solusi/">Lihat Solusi</a>
        <a class="button button--secondary" href="/kontak/">Hubungi kami</a>
      </div>
    </div>
  </section>

  <section class="curator" aria-labelledby="curator-title">
    <div class="container curator__inner">
      {
        FOUNDER ? (
          <>
            <span class="curator__avatar" aria-hidden="true">
              {initials}
            </span>
            <div>
              <h2 id="curator-title" class="eyebrow">
                Dikurasi oleh
              </h2>
              <p class="curator__name">
                {FOUNDER.name} <span>· {FOUNDER.role}</span>
              </p>
              <p class="curator__bio">{FOUNDER.shortBio}</p>
              <p class="curator__meta">
                {FOUNDER.affiliation}. <a href="/tentang/">Tentang Fansightful</a>
              </p>
            </div>
          </>
        ) : (
          <div>
            <h2 id="curator-title" class="eyebrow">
              Dikurasi oleh
            </h2>
            <Pending what="Profil founder/kurator: nama, peran, 1–2 kalimat keahlian yang relevan, foto (opsional)" />
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-12) var(--space-16);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: 1.05fr 1fr;
      padding-block: var(--space-16) var(--space-16);
    }
  }

  .hero h1 {
    margin: var(--space-5) 0 0;
    font-size: var(--text-hero);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .hero__lead {
    max-width: 32em;
    margin: var(--space-6) 0 0;
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .value-props {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: var(--space-10) 0 0;
    padding: var(--space-8) 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .value-props li {
    display: flex;
    flex: 1 1 11rem;
    align-items: center;
    gap: var(--space-3);
  }

  .value-props strong,
  .value-props li > span:last-child > span {
    display: block;
  }

  .value-props strong {
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .value-props li > span:last-child > span {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .hero__visual {
    position: relative;
    margin: 0;
    padding: var(--space-8) var(--space-4) var(--space-4);
  }

  .hero__blob {
    position: absolute;
    inset: 15% -1rem -1rem 10%;
    border-radius: 48% 52% 40% 60% / 55% 45% 55% 45%;
    background: var(--color-teal-tint);
  }

  .hero__photo {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 60% center;
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }

  /* Kartu contoh hasil menumpuk di bagian bawah foto. */
  .preview {
    position: relative;
    max-width: 24rem;
    margin: -2rem var(--space-3) 0 auto;
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-white);
    box-shadow: var(--shadow-float);
  }

  @media (min-width: 40rem) {
    .preview {
      margin: -5rem var(--space-4) 0 auto;
    }
  }

  .preview__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .preview__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .preview__sub {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .preview__rows {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0;
    padding: 0;
    list-style: none;
  }

  .preview__rows li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .status {
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .status--attention {
    background: #fde8e6;
    color: #8f1d14;
  }

  .status--forming {
    background: var(--color-warning-soft);
    color: var(--color-warning-text);
  }

  .status--ok {
    background: var(--color-teal-tint);
    color: var(--color-teal-text);
  }

  .preview__next {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1.5px solid #f6c7a3;
    border-radius: 14px;
  }

  .preview__next p {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .hero__visual figcaption {
    position: relative;
    margin-top: var(--space-3);
    text-align: right;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .band {
    background: var(--color-surface);
  }

  .section {
    padding-block: var(--space-16);
  }

  #cara-kerja:focus {
    outline: none;
  }

  .section__lead {
    max-width: 40rem;
    margin: var(--space-3) 0 0;
    font-size: var(--text-base);
    color: var(--color-ink-muted);
  }

  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .section h2,
  .segments h2,
  .help h2 {
    margin: 0;
  }

  .domain-grid,
  .steps,
  .tool-grid,
  .article-grid {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .domain-grid {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .domain-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .domain-card .tile {
    margin-bottom: var(--space-2);
  }

  .domain-card__name {
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .domain-card__name--people {
    color: var(--domain-people-text);
  }

  .domain-card__name--ops {
    color: var(--domain-ops-text);
  }

  .domain-card__name--fin {
    color: var(--domain-fin-text);
  }

  .domain-card__name--tech {
    color: var(--domain-tech-text);
  }

  .domain-card h3 {
    margin: 0;
  }

  .domain-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  /* Seluruh kartu dapat diklik lewat satu tautan di judul. */
  .domain-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .domain-card--link:hover {
    border-color: var(--color-teal);
  }

  .domain-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .domain-card--navy {
    border-color: var(--color-navy);
    background: var(--color-navy);
    color: var(--color-white);
  }

  .domain-card--navy .domain-card__name {
    color: var(--color-on-navy-muted);
  }

  .domain-card--navy:hover {
    background: var(--color-navy-raised);
  }

  .domain-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .domain-card__cta :global(svg),
  .tool-card__meta :global(svg),
  .article-card__next :global(svg),
  .segments :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }

  .steps {
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .step--next {
    border-color: #f6c7a3;
  }

  .step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step__num {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-text-tertiary);
  }

  .step h3 {
    margin: 0;
  }

  .step p {
    margin: 0;
    font-size: var(--text-sm);
